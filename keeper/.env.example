# Doorstep delivery bot settings. Copy to .env and fill in.
RPC_URL=https://rpc.mainnet.arc.io
CHAIN_ID=5042
# The Doorstep contract to deliver for, and the block it was deployed in.
DOORSTEP=0xd614A7B602E1417F258A834465AE01F47891e080
FROM_BLOCK=25488972
# The bot's own wallet (a Foundry keystore). Keep only a little USDC in it for gas.
KEEPER_KEYSTORE=~/.foundry/keystores/doorstep-keeper
# Unattended runs (VPS): put the keystore password in a file readable only by you (chmod 600).
# Leave empty to type the password when the bot starts.
KEEPER_PASSWORD_FILE=
POLL_MS=2000
