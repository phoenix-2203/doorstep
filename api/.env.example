# Doorstep hosted API settings. Copy to .env (kept out of git).
PORT=8787
HOST=127.0.0.1
# The address people use to reach the API (Caddy serves HTTPS here).
PUBLIC_URL=https://api.YOUR-IP-WITH-DASHES.sslip.io
CHAIN_ID=5042
# Your own RPC (used for registrations, and as backup for reads).
RPC_URL=https://rpc.mainnet.arc.io
# Reads and watching: Arc's public RPC by default, so your RPC plan isn't spent on them.
READ_RPC_URL=https://rpc.mainnet.arc.io
DOORSTEP=0x56BD0FEfdaAF9d053a74107E6dDb9de19D306229
FROM_BLOCK=25509432
PAY_BASE=https://arcdoorstep.duckdns.org/app/
# The wallet that registers new addresses for automatic delivery (node admin.mjs new-wallet).
REGISTER_KEYSTORE=~/.foundry/keystores/doorstep-api
REGISTER_PASSWORD_FILE=~/.doorstep-api-password
CREATES_PER_HOUR=100
