# /etc/caddy/Caddyfile — HTTPS for the Doorstep API. Caddy gets the certificate itself.
# With a free DuckDNS name (point it at your VPS IP): api.<name>.duckdns.org also resolves there.
api.yourname.duckdns.org {
	encode gzip
	reverse_proxy 127.0.0.1:8797
}
# No domain at all? sslip.io works too: replace 203-0-113-10 with your VPS IP, dots as dashes.
# api.203-0-113-10.sslip.io { reverse_proxy 127.0.0.1:8797 }
